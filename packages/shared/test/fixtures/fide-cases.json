  { "id": "repetition-knight-shuffle-twice-not-threefold", "category": "repetition", "fide": "9.2.2", "description": "After one knight shuffle the start position has occurred only twice.", "fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1", "moves": ["g1f3", "g8f6", "f3g1", "f6g8"], "expect": { "threefold": false, "fivefold": false } },
  { "id": "repetition-knight-shuffle-threefold", "category": "repetition", "fide": "9.2.2", "description": "After two knight shuffles the start position has occurred three times (the initial position counts).", "fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1", "moves": ["g1f3", "g8f6", "f3g1", "f6g8", "g1f3", "g8f6", "f3g1", "f6g8"], "expect": { "threefold": true, "fivefold": false } },
  { "id": "repetition-not-consecutive-different-pieces", "category": "repetition", "fide": "9.2.2", "description": "Repetitions need not be consecutive or reached the same way: different knights restore the same position.", "fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1", "moves": ["g1f3", "g8f6", "f3g1", "f6g8", "b1c3", "b8c6", "c3b1", "c6b8"], "expect": { "threefold": true } },
  { "id": "repetition-four-times-not-fivefold", "category": "repetition", "fide": "9.6.1", "description": "Four occurrences: threefold claimable but not yet a fivefold automatic draw.", "fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1", "moves": ["g1f3", "g8f6", "f3g1", "f6g8", "g1f3", "g8f6", "f3g1", "f6g8", "g1f3", "g8f6", "f3g1", "f6g8"], "expect": { "threefold": true, "fivefold": false } },
  { "id": "repetition-fivefold", "category": "repetition", "fide": "9.6.1", "description": "Five occurrences of the start position: the game is drawn automatically.", "fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1", "moves": ["g1f3", "g8f6", "f3g1", "f6g8", "g1f3", "g8f6", "f3g1", "f6g8", "g1f3", "g8f6", "f3g1", "f6g8", "g1f3", "g8f6", "f3g1", "f6g8"], "expect": { "threefold": true, "fivefold": true } },
  { "id": "repetition-castling-rights-differ", "category": "repetition", "fide": "9.2.3.2", "description": "Kings shuffle and return, losing castling rights; the original position (with rights) differs, so after two returns there are only two equal positions.", "fen": "r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1", "moves": ["e1f1", "e8f8", "f1e1", "f8e8", "e1f1", "e8f8", "f1e1", "f8e8"], "expect": { "threefold": false, "illegal": ["e1g1", "e1c1"] } },
  { "id": "repetition-castling-rights-differ-third", "category": "repetition", "fide": "9.2.3.2", "description": "A third return produces the third occurrence of the rights-less position: threefold.", "fen": "r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1", "moves": ["e1f1", "e8f8", "f1e1", "f8e8", "e1f1", "e8f8", "f1e1", "f8e8", "e1f1", "e8f8", "f1e1", "f8e8"], "expect": { "threefold": true } },
  { "id": "repetition-legal-ep-right-differs", "category": "repetition", "fide": "9.2.3.1", "description": "The position right after d7-d5 (with a legal exd6 e.p.) differs from the same placement later, so two knight shuffles give only two equal positions.", "fen": "4k1n1/3p4/8/4P3/8/8/8/4K1N1 b - - 0 1", "moves": ["d7d5", "g1f3", "g8f6", "f3g1", "f6g8", "g1f3", "g8f6", "f3g1", "f6g8"], "expect": { "threefold": false } },
  { "id": "repetition-legal-ep-right-differs-third", "category": "repetition", "fide": "9.2.3.1", "description": "A third shuffle produces the third ep-free occurrence: threefold.", "fen": "4k1n1/3p4/8/4P3/8/8/8/4K1N1 b - - 0 1", "moves": ["d7d5", "g1f3", "g8f6", "f3g1", "f6g8", "g1f3", "g8f6", "f3g1", "f6g8", "g1f3", "g8f6", "f3g1", "f6g8"], "expect": { "threefold": true } },
  { "id": "repetition-illegal-ep-does-not-differ", "knownChessJsDeviation": true, "category": "repetition", "fide": "9.2.3, 9.2.3.1", "description": "After c7-c5 the d5 pawn is pinned (Rd8 vs Kd1), so no en passant capture is possible; that position equals the later ones and occurs three times.", "fen": "3r2nk/2p5/8/3P4/8/8/8/3K2N1 b - - 0 1", "moves": ["c7c5", "g1f3", "g8f6", "f3g1", "f6g8", "g1f3", "g8f6", "f3g1", "f6g8"], "expect": { "threefold": true, "illegal": ["d5c6"], "notes": "chess.js 1.4 hashes the ep square whenever an enemy pawn merely stands next to the pushed pawn (pseudo-legal check in _makeMove), even though its fen() hides the illegal ep square. It therefore counts the first occurrence as a different position and reports isThreefoldRepetition() === false. FIDE 9.2.3 compares the possible (legal) moves, so this is threefold." } },
  { "id": "repetition-same-side-to-move-required", "category": "repetition", "fide": "9.2.3", "description": "The same placement occurs three times, but once with Black to move, so it is not a threefold repetition.", "fen": "7k/8/8/p7/P7/8/8/4K3 w - - 0 1", "moves": ["e1d1", "h8g8", "d1d2", "g8h8", "d2e1", "h8g8", "e1d1", "g8h8", "d1d2", "h8g8", "d2e1", "g8h8"], "expect": { "threefold": false, "notes": "Placement Ke1/Kh8 occurs with White to move twice (start, end) and with Black to move once (after ply 5)." } },

